---
import { Image } from 'astro:assets';
import Test from '../assets/pexels-simon73-1693302.webp';
import Service from '../assets/PouroverPicture.png';
---



<section id="hero-2410" style={`
    background: #11576f url(${Test.src}); 
    background-size: 500px; 
    background-repeat: repeat;
    background-blend-mode: multiply;
  `}>
  <div class="cs-container">
      <div class="cs-content">
          <h1 class="cs-title">Community Driven Specialty Coffee.</h1>
          <p class="cs-text">

          </p>
          <a href="https://order.dripos.com/Bloom" class="cs-button-solid">Order Online</a>
      </div>
      <!--Hero Image-->
      <div class="cs-image-group">
          <!-- IF you have a wide image that gets cut off on the right, go the the cs-picture img and set the left value to a negative number till its where you like it in frame-->
          <picture class="cs-picture circle-crop">
              <!--Mobile Image-->
              <source media="(max-width: 1000px)" src={Service}>
              <!--Tablet and above Image-->
              <source media="(min-width: 1001px)" src={Service}>
              <Image decoding="async" fetchpriority="high" src={Service} alt="Pour over" width="635" height="836" />
          </picture>


      </div>
  </div>
  <!--White curve-->
  <svg class="cs-wave" width="1920" height="167" viewBox="0 0 1920 167" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1920 167H0V0C111.116 45.3334 456.485 136 951 136C1445.52 136 1803.21 45.3334 1920 0V167Z" fill="white"/>
      </svg>
</section>
<style>
/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
#hero-2410 {
    position: relative;
    width: 100%;
    min-height: 100vh; 
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    padding-top: 10.5rem;
    padding-bottom: clamp(4rem, 8vw, 6rem);
    padding-left: 1rem;
    padding-right: 1rem;
    box-sizing: border-box;

    background-repeat: repeat;
    background-position: top left;
    isolation: isolate;
    z-index: 1;
  }

    #hero-2410:before {
      content: '';
      width: 100%;
      height: 100%;
      background: #136A88;
      opacity: .4;
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
    }
    #hero-2410 .cs-container {
      width: 100%;
      max-width: 80rem;
      margin: auto;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      gap: 3rem;
    }
    #hero-2410 .cs-content {
      max-width: 34.375rem;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
    }
    #hero-2410 .cs-topper {
      font-size: 1rem;
      line-height: 1.2em;
      text-transform: uppercase;
      text-align: inherit;
      letter-spacing: 0.1em;
      font-weight: 700;
      color: var(--secondary);
      margin-bottom: 0.25rem;
      display: block;
    }
    #hero-2410 .cs-title {
      text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
      font-size: clamp(2.4375rem, 5vw, 4.5rem);
      font-weight: 900;
      line-height: 1.2em;
      text-align: center;
      max-width: 23ch;
      margin: 0 0 1rem 0;
      color: white;
      position: relative;
    }
    #hero-2410 .cs-text {
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      line-height: 1.5em;
      text-align: center;
      width: 100%;
      max-width: 33.1875rem;
      margin: 0 0 clamp(1.75rem, 3.92vw, 2.5rem) 0;
      color: var(--bodyTextColor);
    }
  #hero-2410 .cs-button-solid {
    text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
    --gradientmix: color-mix(in lab, var(--primary), black 49%);
    font-size: 1.75rem;
    line-height: clamp(5.03125rem, 9.625vw, 6.125rem); 
    text-decoration: none;
    font-weight: 700;
    text-align: center;
    color: #fff;
    white-space: nowrap;
    margin: 0;
    min-width: 16.40625rem; 
    padding: 0 3.0625rem; 
    background: #406EA5;
    box-shadow: 
      0 14px 28px 0 rgba(0,0,0,0.2), 
      0 10.5px 35px 0 rgba(0,0,0,0.19); 
    border-radius: 10.9375rem; 
    overflow: hidden;
    display: inline-block;
    position: relative;
    z-index: 1;
  }
    #hero-2410 .cs-button-solid:before {
      content: '';
      width: 0%;
      height: 100%;
      border-radius: 0.25rem;
      background: var(--secondary);
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
      transition: width 0.3s;
      opacity: 1;
    }
    #hero-2410 .cs-button-solid:hover:before {
      width: 100%;
    }
    #hero-2410 .cs-image-group {
      font-size: min(1.7vw, .55rem);
      width: 52.1875em;
      height: 52.25em;
      flex: none;
      position: relative;
      z-index: 2;
    }




#hero-2410 .cs-picture {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 45em; 
  height: 52.25em;  
  display: flex;
  justify-content: center;
  align-items: center;
}

#hero-2410 .cs-picture img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
    #hero-2410 .cs-circle {
      width: 47.375em;
      height: auto;
      position: absolute;
      right: 0;
      bottom: 1.125em;
      z-index: -1;
    }
    #hero-2410 .cs-circle circle {
      fill: var(--primary);
      opacity: 1; 
    }
    #hero-2410 .cs-arrow {
      width: 4.75em;
      height: auto;
      position: absolute;
      bottom: 11.375em;
      left: 6.4375em;
      transform: rotate(28deg);
    }
    #hero-2410 .cs-no-no {
      width: 10.3125em;
      height: auto;
      display: block;
      position: absolute;
      bottom: 0;
      left: 0;
    }
    #hero-2410 .cs-wave {
      width: 100%;
      height: auto;
      display: block;
      position: absolute;
      bottom: -1px;
      left: 0;
    }
  }
/* Small Desktop - 1024px */
@media only screen and (min-width: 64rem) {
#hero-2410 {
    height: 100vh;
    min-height: 40rem;
    max-height: 100vh;
    box-sizing: border-box;
    
    padding: 9rem 2rem 2rem 2rem;
    text-align: left;
    
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  #hero-2410 .cs-container {
    width: 100%;
    max-width: 80rem;
    height: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  #hero-2410 .cs-content {
    width: 50%;
    max-width: 36rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    z-index: 10;
  }

  #hero-2410 .cs-title {
    text-align: left;
    font-size: clamp(2.25rem, 3.5vw, 3.75rem);
    margin-bottom: 0.75rem;
  }

  #hero-2410 .cs-text {
    text-align: left;
    margin-bottom: 1.5rem;
  }

  #hero-2410 .cs-button-solid {
    font-size: 1.25rem;
    line-height: 3.5rem;
    min-width: 12rem;
    padding: 0 2.25rem;
    border-radius: 3rem;
  }

  #hero-2410 .cs-image-group {
    width: 45%;
    height: 100%;
    max-height: 35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    font-size: 1rem;
  }

  #hero-2410 .cs-picture {
    position: relative;
    top: auto;
    left: auto;
    transform: none;
    width: 100%;
    height: 100%;
    max-height: 32rem;
  }

  #hero-2410 .cs-picture img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #hero-2410 .cs-circle,
  #hero-2410 .cs-arrow,
  #hero-2410 .cs-no-no {
    display: none;
  }
}
</style>