---
import { Image } from 'astro:assets';
// Replace with your preferred feature image asset path
import PourOverImg from '../assets/PouroverPicture.png';
---

<section id="multi-roaster-concept">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">The Multi-Roaster Difference</span>
      <h2 class="cs-title">Always Rotating. Never Bound to One Roaster.</h2>
      <p class="cs-text">
        As a dedicated multi-roaster specialty coffee shop, we don't lock our menu into a single brand or roasting profile. Instead, we continuously source exceptional, limited-lot coffees from world-class domestic and international roasters. 
      </p>
      <p class="cs-text">
        Every rotation brings a brand-new selection of expressively processed origins, rare varieties, and meticulously developed espresso profiles to our bar. Whether you're dropping in for a daily brew or exploring complex pour-over extractions, there is always something distinct waiting in the hopper.
      </p>
      <a href="/about" class="cs-button-solid">Learn More About Us</a>
    </div>

    <div class="cs-image-group">
      <div class="cs-picture-wrapper">
        <Image 
          src={PourOverImg} 
          alt="Multi-roaster pour over brewing" 
          width={600} 
          height={700}
          decoding="async" 
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #multi-roaster-concept {
      width: 100%;
      padding: clamp(3.75rem, 7vw, 6.25rem) 1rem;
      box-sizing: border-box;
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: #fafbfc;
      position: relative;
      z-index: 1;
    }

    #multi-roaster-concept .cs-container {
      width: 100%;
      max-width: 80rem;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(2.5rem, 5vw, 4rem);
    }

    #multi-roaster-concept .cs-content {
      width: 100%;
      max-width: 36rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    #multi-roaster-concept .cs-topper {
      font-size: 1rem;
      line-height: 1.2em;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 700;
      color: var(--secondary, #406EA5);
      margin-bottom: 0.5rem;
      display: block;
    }

    #multi-roaster-concept .cs-title {
      font-size: clamp(1.9375rem, 4.5vw, 3.0625rem);
      font-weight: 900;
      line-height: 1.2em;
      margin: 0 0 1.25rem 0;
      color: var(--primary, #173693);
    }

    #multi-roaster-concept .cs-text {
      font-size: clamp(1rem, 1.5vw, 1.125rem);
      line-height: 1.6em;
      margin: 0 0 1rem 0;
      color: var(--bodyTextColor, #4e4e4e);
    }

    #multi-roaster-concept .cs-text:last-of-type {
      margin-bottom: 2rem;
    }

    #multi-roaster-concept .cs-button-solid {
      font-size: 1rem;
      line-height: clamp(2.875em, 5.5vw, 3.5em);
      text-decoration: none;
      font-weight: 700;
      text-align: center;
      margin: 0;
      color: #fff;
      min-width: 12rem;
      padding: 0 2rem;
      background-color: var(--primary, #173693);
      border-radius: 6.25rem;
      display: inline-block;
      position: relative;
      z-index: 1;
      box-sizing: border-box;
      overflow: hidden;
      transition: color 0.3s ease;
      box-shadow: 0 10px 20px rgba(23, 54, 147, 0.15);
    }

    #multi-roaster-concept .cs-button-solid:before {
      content: '';
      position: absolute;
      height: 100%;
      width: 0%;
      background: #0d215d;
      opacity: 1;
      top: 0;
      left: 0;
      z-index: -1;
      transition: width 0.3s ease;
    }

    #multi-roaster-concept .cs-button-solid:hover {
      color: #fff;
    }

    #multi-roaster-concept .cs-button-solid:hover:before {
      width: 100%;
    }

    #multi-roaster-concept .cs-image-group {
      width: 100%;
      max-width: 34.375rem;
      display: flex;
      justify-content: center;
    }

    #multi-roaster-concept .cs-picture-wrapper {
      width: 100%;
      height: auto;
      aspect-ratio: 4/5;
      background: #f0f4ff;
      border: 2px solid #e0e9ff;
      border-radius: clamp(1.5rem, 3.5vw, 2.5rem);
      padding: 1rem;
      box-shadow: 0px 10px 30px rgba(23, 54, 147, 0.08);
      box-sizing: border-box;
      overflow: hidden;
    }

    #multi-roaster-concept .cs-picture-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: clamp(1rem, 2.5vw, 1.75rem);
    }
  }

  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #multi-roaster-concept .cs-container {
      max-width: 90rem;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    #multi-roaster-concept .cs-content {
      width: 50%;
      max-width: 38rem;
      align-items: flex-start;
      text-align: left;
    }

    #multi-roaster-concept .cs-image-group {
      width: 45%;
      max-width: 32rem;
    }
  }
</style>